# Copy to `.env` and fill in real values for local development.
# `.env` is gitignored.

# Required in production. In development a safe fallback is used if unset.
SECRET_KEY=change-me-in-production

# Optional. Defaults to `<instance_path>/tasks.db`.
DATABASE_PATH=

# One of: development, testing, production. Controls which Config class is loaded.
FLASK_ENV=development
